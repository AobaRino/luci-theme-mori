{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call("system", "board");
	const hostname = entityencode(striptags(boardinfo?.hostname ?? '?'), true);

	http.prepare_content('text/html; charset=UTF-8');

	const bar_color = '#ffffff';
	const tile_color = '#27634c';
	const moriNative = index([
		"", "admin", "admin/nas", "admin/network", "admin/network/dhcp",
		"admin/network/diagnostics", "admin/network/dns", "admin/network/firewall",
		"admin/network/firewall/custom", "admin/network/firewall/forwards",
		"admin/network/firewall/ipsets", "admin/network/firewall/rules",
		"admin/network/firewall/snats", "admin/network/firewall/zones",
		"admin/network/network", "admin/network/routes", "admin/network/switch",
		"admin/network/wireless", "admin/services", "admin/status",
		"admin/status/channel_analysis", "admin/status/iptables", "admin/status/logs",
		"admin/status/logs/dmesg", "admin/status/logs/syslog", "admin/status/nftables",
		"admin/status/nftables/iptables", "admin/status/overview",
		"admin/status/processes", "admin/status/realtime",
		"admin/status/realtime/bandwidth", "admin/status/realtime/connections",
		"admin/status/realtime/load", "admin/status/realtime/wireless",
		"admin/status/routes", "admin/status/routesj", "admin/system",
		"admin/system/admin", "admin/system/admin/dropbear",
		"admin/system/admin/password", "admin/system/admin/repokeys",
		"admin/system/admin/sshkeys", "admin/system/admin/uhttpd",
		"admin/system/crontab", "admin/system/flash", "admin/system/leds",
		"admin/system/mounts", "admin/system/package-manager", "admin/system/reboot",
		"admin/system/startup", "admin/system/system", "admin/uci", "admin/vpn"
	], join('/', ctx.request_path)) >= 0;
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ hostname }}{{ node?.title ? ` - ${entityencode(striptags(node.title), true)}` : '' }} - Mori</title>

	<meta name="robots" content="noindex, nofollow">
	<meta name="referrer" content="strict-origin-when-cross-origin">
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="default">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - Mori">
	<meta name="theme-color" content="{{ bar_color }}">
	<meta name="msapplication-TileColor" content="{{ tile_color }}">
	<meta name="application-name" content="{{ hostname }} - Mori">

	<link rel="icon" type="image/svg+xml" href="{{ media }}/icon.svg?v=65d7ffbb254b">
	<link rel="manifest" href="{{ media }}/manifest.webmanifest?v=17f328301f05" crossorigin="use-credentials">

	<link rel="stylesheet" href="{{ media }}/css/cascade.css?v=7bc44a4cf5d5">
	<link rel="stylesheet" href="{{ media }}/mori.css?v=c8e45f8a2932">
	<script src="{{ media }}/theme.js?v=39c4eeb582fa"></script>
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}"></script>
</head>

<body
	class="mori-modern {{ moriNative ? 'mori-native' : 'mori-plugin' }} lang_{{ dispatcher.lang }} {% if (ctx.authsession): %}logged-in{% endif %}"
	data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

	<div class="main">
		<div class="main-left" id="mainmenu" style="display:none">
			<div class="sidenav-header">
				<a class="brand" href="{{ dispatcher.build_url('admin/status/overview') }}"><span class="mori-brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 18V6l7 8 7-8v12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="mori-brand-copy">Mori<small>LUCI THEME</small></span></a>
			</div>
			<div class="mori-sidebar-footer"><strong>{{ hostname }}</strong><span>{{ entityencode(boardinfo.release?.target ?? 'LuCI', true) }} · {{ _('Local admin') }}</span></div>
		</div>
		<div class="main-right">
			<header class="bg-primary">
				<div class="fill">
					<div class="container">
						<div class="flex1">
							<a class="showSide" href="#" role="button" aria-label="{{ entityencode(_('Open navigation menu'), true) }}" aria-expanded="false"></a>
							<span class="mori-topbar-title">{{ hostname }}<span>{{ _('Admin Console') }}</span></span>
						</div>
						<div class="mori-topbar-actions"><button type="button" class="mori-theme-toggle" aria-label="{{ entityencode(_('Toggle light/dark theme'), true) }}" title="{{ entityencode(_('Toggle light/dark theme'), true) }}" data-label-light="{{ entityencode(_('Switch to light theme'), true) }}" data-label-dark="{{ entityencode(_('Switch to dark theme'), true) }}">◐</button><div class="status" id="indicators"></div></div>
					</div>
				</div>
			</header>
			<div class="darkMask"></div>
			<div id="maincontent">
				<div class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message error">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message error">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
