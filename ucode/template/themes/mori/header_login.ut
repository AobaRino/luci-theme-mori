{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{%
	const boardinfo = ubus.call("system", "board");
	const hostname = entityencode(striptags(boardinfo?.hostname ?? '?'), true);

	http.prepare_content('text/html; charset=UTF-8');

	const bar_color = '#f4f6f5';
	const tile_color = '#27634c';
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ hostname }}{{ node?.title ? ` - ${entityencode(striptags(node.title), true)}` : '' }} - Mori</title>

	<meta name="robots" content="noindex, nofollow">
	<meta name="referrer" content="strict-origin-when-cross-origin">
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="default">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - Mori">
	<meta name="theme-color" content="{{ bar_color }}">
	<meta name="msapplication-TileColor" content="{{ tile_color }}">
	<meta name="application-name" content="{{ hostname }} - Mori">

	<link rel="icon" type="image/svg+xml" href="{{ media }}/icon.svg?v=65d7ffbb254b">
	<link rel="manifest" href="{{ media }}/manifest.webmanifest?v=17f328301f05" crossorigin="use-credentials">

	<link rel="stylesheet" href="{{ media }}/css/cascade.css?v=7bc44a4cf5d5">
	<link rel="stylesheet" href="{{ media }}/mori.css?v=293d034b33d1">
	<script src="{{ media }}/theme.js?v=27ccaa2bea8f"></script>
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
</head>

<body class="mori-modern mori-native mori-login">
