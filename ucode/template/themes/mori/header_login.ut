{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{%
	import { readfile, access } from 'fs';
	import { cursor } from 'uci';
	import { srand } from 'math';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	let cfg = cursor();

	//send as HTML5
	http.prepare_content('text/html; charset=UTF-8');

	srand(+substr(reverse(time() + ""), 0, 8));

	let bar_color = '#27634c';
	const moriNative = index(["", "admin", "admin/logout", "admin/menu", "admin/nas", "admin/network", "admin/network/dhcp", "admin/network/diagnostics", "admin/network/dns", "admin/network/firewall", "admin/network/firewall/custom", "admin/network/firewall/forwards", "admin/network/firewall/ipsets", "admin/network/firewall/rules", "admin/network/firewall/snats", "admin/network/firewall/zones", "admin/network/network", "admin/network/remote_addr/*", "admin/network/routes", "admin/network/switch", "admin/network/wireless", "admin/services", "admin/status", "admin/status/channel_analysis", "admin/status/iptables", "admin/status/logs", "admin/status/logs/dmesg", "admin/status/logs/syslog", "admin/status/nftables", "admin/status/nftables/iptables", "admin/status/overview", "admin/status/processes", "admin/status/realtime", "admin/status/realtime/bandwidth", "admin/status/realtime/connections", "admin/status/realtime/load", "admin/status/realtime/wireless", "admin/status/routes", "admin/status/routesj", "admin/system", "admin/system/admin", "admin/system/admin/dropbear", "admin/system/admin/password", "admin/system/admin/repokeys", "admin/system/admin/sshkeys", "admin/system/admin/uhttpd", "admin/system/crontab", "admin/system/flash", "admin/system/leds", "admin/system/mounts", "admin/system/package-manager", "admin/system/reboot", "admin/system/startup", "admin/system/system", "admin/translations/*", "admin/ubus/*", "admin/uci", "admin/uci/apply_rollback", "admin/uci/apply_unchecked", "admin/uci/confirm", "admin/uci/revert", "admin/vpn"], join('/', ctx.request_path)) >= 0;
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - Mori</title>

	<!-- SEO and Description -->
	<meta name="robots" content="noindex, nofollow">

	<!-- Security -->
	<meta http-equiv="X-Content-Type-Options" content="nosniff">
	<meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
	<meta http-equiv="X-XSS-Protection" content="1; mode=block">
	<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

	<!-- Mobile and PWA -->
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - Mori">

	<!-- Theme and Colors -->
	<meta name="theme-color" content="{{ bar_color }}">
	<meta name="msapplication-TileColor" content="{{ bar_color }}">
	<meta name="application-name" content="{{ hostname }} - Mori">

	<!-- Mori identity; no device-specific icons or external font requests. -->
	<link rel="icon" type="image/svg+xml" href="{{ media }}/icon.svg?v=65d7ffbb254b">
	<link rel="manifest" href="{{ media }}/manifest.webmanifest" crossorigin="use-credentials">

	<link rel="stylesheet" href="{{ media }}/css/cascade.css?v=0d223091b0a9">
	<link rel="stylesheet" href="{{ media }}/css/dark.css?v=b7983770fabb" id="mori-dark-css" media="not all">
	<link rel="stylesheet" href="{{ media }}/mori.css?v=2bfe1d42db4b">
	<script src="{{ media }}/theme.js?v=d66b885a37f3"></script>
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css}}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}

</head>

<body class="mori-modern mori-native mori-login">
